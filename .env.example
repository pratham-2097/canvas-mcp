# Copy this file to .dev.vars for local stdio/wrangler dev testing.
# Never commit the real values. Set them in production via `wrangler secret put <NAME>`.

# Canvas personal access token (UC Canvas -> Account -> Settings -> New Access Token).
# Must only ever be used as an Authorization: Bearer header value. Never log it.
CANVAS_TOKEN=

# Base URL for UC's Canvas API (no trailing slash).
CANVAS_BASE_URL=https://uc.instructure.com/api/v1

# Shared secret that gates the deployed remote MCP server (single-user auth).
# Pick a long random string, e.g. `openssl rand -hex 32`.
ACCESS_PASSPHRASE=
