{
  "name": "canvas-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Personal read-only remote MCP server for Canvas LMS (University of Cincinnati): every student read feature, token-lean",
  "scripts": {
    "dev:stdio": "tsx src/stdio.ts",
    "inspector": "npx @modelcontextprotocol/inspector tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "footprint": "tsx scripts/tool-footprint.ts",
    "call": "tsx scripts/call.ts",
    "check:live": "tsx scripts/live-check.ts",
    "check:remote": "tsx scripts/live-check.ts",
    "wrangler:dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5",
    "unpdf": "^1.8.1",
    "mammoth": "^1.8.0",
    "fflate": "^0.8.2",
    "node-html-markdown-cloudflare": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
